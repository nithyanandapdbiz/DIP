# DBiz Execution Plane — tenant configuration as environment variables.
#
# Copy this file to `.env` in your deployment. It ships as `env.example` because
# a file named `.env*` is treated as a secret by scanners — including this
# platform's own — and a documentation file should not have to be exempted.
#
# The one-time registration credential is deliberately ABSENT from this file.
# It belongs in your secret store, injected at start. A credential committed to a
# repository outlives every rotation policy you will ever write.
DBIZ_TENANT_ID=tenant-example
DBIZ_REGISTRATION_ENDPOINT=https://gateway.example.test/v1/register
DBIZ_PROFILE_VERSION=1.0.0
DBIZ_LANGUAGE=typescript
DBIZ_FRAMEWORK=selenium
DBIZ_TEST_RUNNER=jest
DBIZ_CI_SYSTEM=github-actions
DBIZ_GIT_PROVIDER=github
DBIZ_CLOUD_PROVIDER=azure
DBIZ_DEPLOYMENT_MODEL=container
DBIZ_PACKAGE_MANAGER=pnpm
DBIZ_REPORTING_FRAMEWORK=allure
DBIZ_FRAMEWORK_VERSIONS_@TYPES/SELENIUM-WEBDRIVER=4.1.28
DBIZ_FRAMEWORK_VERSIONS_ALLURE-JEST=3.0.7
DBIZ_FRAMEWORK_VERSIONS_JEST=29.7.0
DBIZ_FRAMEWORK_VERSIONS_SELENIUM-WEBDRIVER=4.27.0
DBIZ_FRAMEWORK_VERSIONS_TYPESCRIPT=5.7.2
