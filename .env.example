# DBiz Intelligence Plane — environment template (ADR-0060).
#
# Copy to `.env` (gitignored) for local development / docker compose. The SAME variable names drive
# every environment; only their VALUES change between local, dev, qa, uat and production. In Azure,
# secrets come from Key Vault (secretRef → env) and non-secrets are plain Container App env values.
#
#   cp .env.example .env && docker compose up --build
#
# The Configuration Provider (@dbiz/platform-providers) is the single reader of these variables and
# validates them at startup, fail-fast, with a clear diagnostic.

# ── Deployment environment (diagnostics/logging only — never a security control) ──
DBIZ_ENV=local                 # local | development | qa | uat | production
DBIZ_LOG_LEVEL=info            # debug | info | warn | error

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
DBIZ_HOST=0.0.0.0              # bind address (0.0.0.0 so container ingress can reach it)
DBIZ_BASE_PATH=               # optional reverse-proxy base path (App Gateway)

# ── State / storage (Azure Files mount in cloud; a local folder or memory locally) ──
DBIZ_STATE_DIR=./.local-state  # container default is /state (an Azure Files mount)
DBIZ_STORAGE_BACKEND=filesystem  # filesystem | memory
DBIZ_STORAGE_ROOT=./.local-state

# ── Secrets (env in cloud [Key Vault → env]; file/memory locally) ──
DBIZ_SECRET_BACKEND=env        # env | file | memory
DBIZ_SECRET_DIR=./.local-secrets
# REQUIRED. Signs DBIZ sessions AND EP credentials — keep a SINGLE STABLE value (rotating revokes EP
# credentials). In Azure this arrives from Key Vault; the value below is a LOCAL-ONLY throwaway.
SESSION_SECRET=local-dev-only-change-me-not-a-real-secret

# ── Distributed state (Azure Cache for Redis in cloud; in-memory locally) ──
# memory = correct at ONE replica only (KNOWN_LIMITATIONS L-2). redis = required before maxReplicas > 1,
# because nonce replay protection, distributed locks, rate-limit counters and the OTC single-use gate
# must be shared across replicas. Selecting redis requires the `ioredis` driver in the image; the app
# REFUSES TO START if it is selected and the driver is absent, rather than silently degrading.
DBIZ_STATE_BACKEND=memory      # memory | redis
# REDIS_URL=redis://localhost:6379   # setting this selects the redis backend automatically
DBIZ_KEY_PREFIX=dbiz

# ── Authentication (Microsoft Entra) ─────────────────────────────────────────────
# Set both for real sign-in. Leave unset locally and use DBIZ_DEV_AUTH=1 (unsigned dev verifier).
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
IP_ADMIN_ALLOWLIST=admin@dbiz.example
DBIZ_DEV_AUTH=1                # LOCAL ONLY — accepts unsigned dev:<email> tokens. MUST be unset in Azure.
                               # The app REFUSES TO START if this is set in a production environment.

# ── Tenant-scoped RBAC (C-07.11) ─────────────────────────────────────────────────
# Roles come from Entra app-role assignments; tenant scope from Entra group membership.
# Recognised app roles: dbiz.platform.admin | dbiz.tenant.admin | dbiz.viewer
#
# 1 = every operator MUST hold a recognised app role; an identity with none is refused.
# 0 = transitional — an identity with no role falls back to the allow-list ⇒ platform-admin.
# A PRODUCTION deployment must set this EXPLICITLY (the app refuses to start otherwise): inheriting
# the transitional default is how "every authenticated user is a global admin" survives unnoticed.
DBIZ_REQUIRE_ENTRA_ROLES=0
# Entra group object-id → tenant slugs. `<groupId>:<slug>|<slug>,<groupId>:<slug>`
# A tenant-scoped principal whose groups map to nothing reaches NO tenant (fail-closed).
# DBIZ_GROUP_TENANT_MAP=00000000-0000-0000-0000-000000000001:acme-corp,...:globex

# ── Web tier / edge ──────────────────────────────────────────────────────────────
# Exact browser origins allowed to call the API. Empty = same-origin only (deny by default; there is
# no wildcard). REQUIRED in production — set it to "" to declare same-origin-only deliberately.
DBIZ_CORS_ORIGINS=
# Honour x-forwarded-proto / x-forwarded-for. Set to 1 ONLY behind a proxy that overwrites them
# (Azure Application Gateway). Trusting them without a proxy lets any caller forge its client address
# and defeat the rate limiter.
DBIZ_TRUST_PROXY=0

# ── Cross-plane registration ─────────────────────────────────────────────────────
REGISTRATION_ENDPOINT=https://gateway.dbiz.example/v1/register
INTELLIGENCE_CONTRACT_VERSION=1.0.0
