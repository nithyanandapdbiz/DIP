      "reasoningType": "classification",
      "executionType": "reasoning",
      "knowledgeType": "healing-policy",
      "ciEnforcementRule": "GATE no-knowledge-vocabulary"
    },
    {
      "capabilityId": "automation-architecture-review",
      "ownerPlane": "IP",
      "purpose": "Assign severity to automation findings and decide whether a suite is fit to execute.",
      "inputContract": "automation findings from the Execution Plane",
      "outputContract": "dbiz.policy-tables@1 severities",
      "producer": "packages/contracts/src/policy-tables.ts#DEFAULT_POLICY_TABLES.automation",
      "consumers": ["policy-evaluation"],
      "sourceOfTruth": "the policy tables contract",
      "reasoningType": "classification",
      "executionType": "review",
      "knowledgeType": "automation-architecture",
      "ciEnforcementRule": "GATE no-ep-certification"
    },
    {
      "capabilityId": "defect-triage",
      "ownerPlane": "IP",
      "purpose": "Decide whether a failure is genuine, what caused it, what it costs the business, and at what priority and severity.",
      "inputContract": "dbiz.step-ledger@1 and dbiz.evidence-ref@1",
      "outputContract": "Defect[]",
      "producer": "packages/functional-testing-engine/src/agents/automation-execution-healing.ts#defect agents",
      "consumers": ["defect-synchronisation"],
      "sourceOfTruth": "the defect domain orchestrator",
      "reasoningType": "reconciliation",
      "executionType": "decision",
      "knowledgeType": "defect-triage",
      "ciEnforcementRule": "GATE no-invented-test-content"
