    },
    {
      "capabilityId": "reuse-decision",
      "ownerPlane": "IP",
      "purpose": "Decide which existing test assets to reuse, merge or supersede, from the similarity scores the Execution Plane returned.",
      "inputContract": "RepositoryMatch[]",
      "outputContract": "ReuseDecision[]",
      "producer": "packages/functional-testing-engine/src/agents/repository-and-authoring.ts#repository.reuse-decision",
      "consumers": ["test-case-synchronisation"],
      "sourceOfTruth": "repository.reuse-decision",
      "reasoningType": "reconciliation",
      "executionType": "decision",
      "knowledgeType": "reuse-decision",
      "ciEnforcementRule": "GATE no-ep-certification"
    },
    {
      "capabilityId": "grounded-authoring",
      "ownerPlane": "IP",
      "purpose": "Bind authored test steps to controls the Execution Plane actually observed, and refuse to author against a selector nobody saw.",
