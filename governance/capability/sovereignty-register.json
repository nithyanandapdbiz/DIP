      "outputContract": "dbiz.execution-package@2",
      "producer": "packages/functional-testing-engine/authoring-bridge.mjs#groundOperations",
      "consumers": ["browser-execution"],
      "sourceOfTruth": "the authoring bridge",
      "reasoningType": "generation",
      "executionType": "planning",
      "knowledgeType": null,
      "ciEnforcementRule": "authoring-refuses-ungrounded"
