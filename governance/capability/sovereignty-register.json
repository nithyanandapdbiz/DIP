{
  "_note": "The Capability Sovereignty Register — one declaration per capability, platform-wide. Validated by governance/capability/run-sovereignty-register.mjs, which fails the build on a duplicate id, a duplicate knowledge type, or an Execution-Plane capability that reasons, owns knowledge, reviews, certifies, plans or decides. See docs/audit/PLANE-SOVEREIGNTY-AUDIT.md and docs/audit/SOVEREIGNTY-REMEDIATION.md.",
  "contractVersion": "1.0.0",
  "capabilities": [
    {
      "capabilityId": "work-item-collection",
      "ownerPlane": "EP",
      "purpose": "Retrieve a work item, its linked items, comments and revision history from the customer's project-management system, verbatim.",
      "inputContract": "tenant configuration",
      "outputContract": "dbiz.observation-set@1",
      "producer": "carlisle-homes/src/functional-testing/observation/collectors.mjs#collectWorkItems",
      "consumers": ["observation-interpretation", "story-intelligence"],
      "sourceOfTruth": "the customer's Azure DevOps project",
      "reasoningType": "none",
      "executionType": "collection",
      "knowledgeType": null,
      "ciEnforcementRule": "GATE no-knowledge-vocabulary"
    },
    {
      "capabilityId": "text-span-collection",
      "ownerPlane": "EP",
      "purpose": "Hand over customer prose with its field provenance and no classification, so the Intelligence Plane can recognise what is in it.",
      "inputContract": "tenant configuration",
      "outputContract": "dbiz.observation-set@1",
      "producer": "carlisle-homes/src/functional-testing/observation/collectors.mjs#collectTextSpans",
      "consumers": ["business-rule-extraction", "entity-discovery", "requirement-decomposition"],
      "sourceOfTruth": "the customer's work item fields",
      "reasoningType": "none",
      "executionType": "collection",
      "knowledgeType": null,
      "ciEnforcementRule": "GATE no-prose-heuristics"
    },
    {
      "capabilityId": "formal-specification-parsing",
      "ownerPlane": "EP",
      "purpose": "Read operations out of an attached OpenAPI document. Parsing a schema is reading, not interpreting.",
      "inputContract": "retrieved artefact bytes",
      "outputContract": "dbiz.observation-set@1",
      "producer": "carlisle-homes/src/functional-testing/observation/collectors.mjs#parseFormalSpecifications",
      "consumers": ["test-design"],
      "sourceOfTruth": "the attached specification document",
      "reasoningType": "none",
      "executionType": "parsing",
      "knowledgeType": null,
      "ciEnforcementRule": "GATE no-knowledge-vocabulary"
    },
    {
      "capabilityId": "control-inventory-collection",
      "ownerPlane": "EP",
      "purpose": "Enumerate the controls the application actually rendered, with selector uniqueness measured in the live page.",
      "inputContract": "authenticated browser session",
      "outputContract": "dbiz.observation-set@1",
      "producer": "carlisle-homes/src/functional-testing/runtime/selector-discovery.mjs",
      "consumers": ["grounded-authoring"],
      "sourceOfTruth": "the running application",
      "reasoningType": "none",
      "executionType": "collection",
      "knowledgeType": null,
      "ciEnforcementRule": "GATE no-knowledge-vocabulary"
    },
    {
      "capabilityId": "repository-inventory-collection",
      "ownerPlane": "EP",
      "purpose": "List existing test cases, shared steps and automation assets in the customer's repositories, returning no source content.",
      "inputContract": "tenant configuration",
      "outputContract": "dbiz.observation-set@1",
      "producer": "carlisle-homes/src/functional-testing/observation/collectors.mjs#collectRepository",
      "consumers": ["reuse-decision"],
      "sourceOfTruth": "the customer's test and automation repositories",
      "reasoningType": "none",
      "executionType": "collection",
      "knowledgeType": null,
      "ciEnforcementRule": "GATE no-knowledge-vocabulary"
    },
    {
      "capabilityId": "browser-execution",
      "ownerPlane": "EP",
      "purpose": "Drive the customer's live application through the operations the Intelligence Plane authored, and report what happened.",
      "inputContract": "dbiz.execution-package@2",
      "outputContract": "dbiz.step-ledger@1",
      "producer": "carlisle-homes/src/functional-testing/runtime/browser.mjs",
      "consumers": ["failure-taxonomy", "defect-triage", "release-certification"],
      "sourceOfTruth": "the running application",
      "reasoningType": "none",
      "executionType": "execution",
      "knowledgeType": null,
      "ciEnforcementRule": "GATE no-ep-certification"
    },
    {
      "capabilityId": "evidence-custody",
      "ownerPlane": "EP",
      "purpose": "Capture, hash, retain and purge execution evidence inside the customer's tenancy, emitting references only.",
      "inputContract": "browser session artefacts",
      "outputContract": "dbiz.evidence-ref@1",
      "producer": "carlisle-homes/src/functional-testing/runtime/evidence.mjs",
      "consumers": ["defect-triage", "release-certification"],
      "sourceOfTruth": "the customer's evidence directory",
      "reasoningType": "none",
      "executionType": "evidence",
      "knowledgeType": null,
      "ciEnforcementRule": "evidence-reference-has-no-content"
    },
    {
      "capabilityId": "target-conformance",
      "ownerPlane": "EP",
      "purpose": "Condense an authored value to what the target system accepts, without altering what the test covers or asserts.",
      "inputContract": "dbiz.execution-package@2",
      "outputContract": "work item fields",
      "producer": "carlisle-homes/src/functional-testing/phases/authoring.mjs#conformToTarget",
      "consumers": ["test-case-synchronisation"],
      "sourceOfTruth": "Azure DevOps field limits",
      "reasoningType": "none",
      "executionType": "normalization",
      "knowledgeType": null,
      "ciEnforcementRule": "GATE no-invented-test-content"
    },
    {
      "capabilityId": "test-case-synchronisation",
      "ownerPlane": "EP",
      "purpose": "Write the Intelligence Plane's authored test cases, plans, results and defects into the customer's systems.",
      "inputContract": "dbiz.execution-package@2",
      "outputContract": "work items in the customer's project",
      "producer": "carlisle-homes/src/functional-testing/phases/intelligence.mjs",
      "consumers": ["the customer's Azure DevOps project"],
      "sourceOfTruth": "the authored package",
      "reasoningType": "none",
      "executionType": "synchronisation",
      "knowledgeType": null,
      "ciEnforcementRule": "GATE no-invented-test-content"
    },
    {
      "capabilityId": "policy-evaluation",
      "ownerPlane": "EP",
      "purpose": "Evaluate the rule tables the Intelligence Plane authored and signed into the package. It authors none of them.",
      "inputContract": "dbiz.policy-tables@1",
      "outputContract": "classified tokens and policy verdicts",
      "producer": "carlisle-homes/src/functional-testing/runtime/policy-evaluator.mjs",
      "consumers": ["failure-taxonomy", "healing-policy", "automation-architecture-review"],
      "sourceOfTruth": "the Intelligence Plane's policy tables",
      "reasoningType": "none",
      "executionType": "parsing",
      "knowledgeType": null,
      "ciEnforcementRule": "GATE no-knowledge-vocabulary"
    },

    {
      "capabilityId": "requirement-decomposition",
      "ownerPlane": "IP",
      "purpose": "Split acceptance-criteria text into discrete criteria. The criterion count is the coverage denominator.",
      "inputContract": "dbiz.observation-set@1",
      "outputContract": "Requirement[]",
      "producer": "packages/functional-testing-engine/src/domains/observation-interpretation.ts#decomposeAcceptanceCriteria",
      "consumers": ["story-intelligence", "test-design", "coverage-measurement"],
      "sourceOfTruth": "observation-interpretation domain",
      "reasoningType": "extraction",
      "executionType": "reasoning",
      "knowledgeType": "requirement-decomposition",
      "ciEnforcementRule": "GATE no-knowledge-modules"
    },
    {
      "capabilityId": "business-rule-extraction",
      "ownerPlane": "IP",
      "purpose": "Identify the business rules a requirement states, classifying by obligation markers and citing the span each came from.",
      "inputContract": "dbiz.observation-set@1",
      "outputContract": "Requirement[] of kind business-rule",
      "producer": "packages/functional-testing-engine/src/agents/story-and-test.ts#story.business-rule-extraction",
      "consumers": ["test-design", "coverage-measurement"],
      "sourceOfTruth": "story.business-rule-extraction",
      "reasoningType": "classification",
      "executionType": "reasoning",
      "knowledgeType": "business-rule",
      "ciEnforcementRule": "GATE no-prose-heuristics"
    },
    {
      "capabilityId": "entity-discovery",
      "ownerPlane": "IP",
      "purpose": "Reconstruct the business entities an application and its requirements describe, from observed fields and parameters.",
      "inputContract": "dbiz.observation-set@1",
      "outputContract": "BusinessEntity[]",
      "producer": "packages/discovery-flow-engine/src/agents/intelligence-and-model.ts#appintel.entities",
      "consumers": ["test-design", "knowledge-graph"],
      "sourceOfTruth": "appintel.entities",
      "reasoningType": "extraction",
      "executionType": "reasoning",
      "knowledgeType": "entity",
      "ciEnforcementRule": "GATE no-prose-heuristics"
    },
    {
      "capabilityId": "persona-discovery",
      "ownerPlane": "IP",
      "purpose": "Identify the actors and roles a requirement places in scope, so role-based scenarios can be designed.",
      "inputContract": "dbiz.observation-set@1",
      "outputContract": "Persona[]",
      "producer": "packages/functional-testing-engine/src/domains/story-intelligence.ts",
      "consumers": ["test-design"],
      "sourceOfTruth": "story-intelligence personas",
      "reasoningType": "extraction",
      "executionType": "reasoning",
      "knowledgeType": "persona",
      "ciEnforcementRule": "GATE no-prose-heuristics"
    },
    {
      "capabilityId": "artefact-classification",
      "ownerPlane": "IP",
      "purpose": "Decide what an attached file is for testing purposes — a mockup, an API contract, a rules document.",
      "inputContract": "dbiz.observation-set@1",
      "outputContract": "ArtefactKind per artefact",
      "producer": "packages/functional-testing-engine/src/domains/observation-interpretation.ts#classifyArtefact",
      "consumers": ["story-completeness", "test-design"],
      "sourceOfTruth": "observation-interpretation domain",
      "reasoningType": "classification",
      "executionType": "reasoning",
      "knowledgeType": "artefact-classification",
      "ciEnforcementRule": "GATE no-knowledge-modules"
    },
    {
      "capabilityId": "story-completeness",
      "ownerPlane": "IP",
      "purpose": "Assess which signals a complete story would carry and report which are present, without issuing a fitness verdict.",
      "inputContract": "dbiz.observation-set@1",
      "outputContract": "CompletenessSignal[]",
      "producer": "packages/functional-testing-engine/src/domains/observation-interpretation.ts#assessCompleteness",
      "consumers": ["story-review", "executive-reporting"],
      "sourceOfTruth": "observation-interpretation domain",
      "reasoningType": "classification",
      "executionType": "reasoning",
      "knowledgeType": "completeness",
      "ciEnforcementRule": "GATE no-ratio-computation"
    },
    {
      "capabilityId": "risk-assessment",
      "ownerPlane": "IP",
      "purpose": "Assign a risk level to each requirement from explicit, stated factors, and always state the rationale.",
      "inputContract": "Requirement[]",
      "outputContract": "RiskAssessment[]",
      "producer": "packages/functional-testing-engine/src/agents/story-and-test.ts#story.risk-analysis",
      "consumers": ["test-design", "release-certification"],
      "sourceOfTruth": "story.risk-analysis",
      "reasoningType": "ranking",
      "executionType": "reasoning",
      "knowledgeType": "risk",
      "ciEnforcementRule": "GATE no-knowledge-vocabulary"
    },
    {
      "capabilityId": "test-design",
      "ownerPlane": "IP",
      "purpose": "Generate test scenarios per technique from the interpreted requirements, and deduplicate across them.",
      "inputContract": "Requirement[]",
      "outputContract": "Scenario[] and TestCase[]",
      "producer": "packages/functional-testing-engine/src/agents/story-and-test.ts#testAgents",
      "consumers": ["grounded-authoring", "test-case-synchronisation"],
