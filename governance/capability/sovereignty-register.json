      "producer": "packages/functional-testing-engine/src/agents/story-and-test.ts#test.coverage-analysis",
      "consumers": ["executive-reporting", "release-certification"],
      "sourceOfTruth": "test.coverage-analysis",
      "reasoningType": "none",
      "executionType": "reasoning",
      "knowledgeType": "coverage",
